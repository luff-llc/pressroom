<?xml version="1.0" encoding="UTF-8"?>
<!-- Example only. A LaunchAgent for the user that runs the work. Nothing installs it. -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>works.luff.pressroom</string>
  <key>ProgramArguments</key>
  <array><string>/usr/local/bin/pressroom</string><string>daemon</string></array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>StandardErrorPath</key><string>/tmp/pressroom.log</string>
</dict>
</plist>
